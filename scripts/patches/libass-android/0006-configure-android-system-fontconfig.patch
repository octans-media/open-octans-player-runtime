+static const char* getOptionalString(JNIEnv* env, jstring value) {
+    if (value == NULL) {
+        return NULL;
+    }
+    return (*env)->GetStringUTFChars(env, value, NULL);
+}
+
+static void releaseOptionalString(JNIEnv* env, jstring value, const char* chars) {
+    if (value != NULL && chars != NULL) {
+        (*env)->ReleaseStringUTFChars(env, value, chars);
+    }
+}
+
+void nativeAssConfigureFonts(JNIEnv* env, jclass clazz, jlong ass, jstring defaultFont, jstring defaultFamily, jstring fontConfig, jstring fontsDir) {
+    if (!ass) return;
+    const char* cFontsDir = getOptionalString(env, fontsDir);
+    if (cFontsDir != NULL && strlen(cFontsDir) > 0) {
+        ass_set_fonts_dir((ASS_Library *) ass, cFontsDir);
+    }
+    releaseOptionalString(env, fontsDir, cFontsDir);
+}
