FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
    OCTANS_RUNTIME_ROOT=/workspace \
    OCTANS_RUNTIME_OUTPUT=/dist \
    OCTANS_RUNTIME_SOURCE_CACHE=/cache/sources

RUN apt-get update \
 && apt-get dist-upgrade -y \
 && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    bash \
    binutils \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    file \
    git \
    gperf \
    jq \
    libtool \
    make \
    meson \
    nasm \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    tar \
    unzip \
    xz-utils \
    yasm \
    zip \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY build-manifests/ /workspace/build-manifests/
COPY scripts/container/ /workspace/scripts/container/
COPY scripts/verify-android-runtime-artifact.sh /workspace/scripts/verify-android-runtime-artifact.sh
COPY scripts/verify-android-armeabi-v7a-runtime-artifact.sh /workspace/scripts/verify-android-armeabi-v7a-runtime-artifact.sh

ENTRYPOINT ["/workspace/scripts/container/build-android-armeabi-v7a-lgpl-runtime.sh"]
